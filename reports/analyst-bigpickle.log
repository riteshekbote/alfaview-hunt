import re,json
s=open('app.js',encoding='utf-8',errors='replace').read()
anchors=[m.start() for m in re.finditer(r'\{kind:"OperationDefinition",operation:"(mutation|query)"',s)]
def block_at(i):
    d=0;j=i
    while j<len(s):
        if s[j]=='{':d+=1
        elif s[j]=='}':
            d-=1
            if d==0: return s[i:j+1]
        j+=1
    return s[i:]
seen={}
for i in anchors:
    b=block_at(i)
    op=re.search(r'operation:"(mutation|query)"',b).group(1)
    nm=re.search(r'operation:"(?:mutation|query)",name:\{kind:"Name",value:"([A-Za-z0-9_]+)"',b)
    if not nm: continue
    name=nm.group(1)
    # split into variableDefinition chunks
    vars=[]
    for m in re.finditer(r'kind:"VariableDefinition",variable:\{kind:"Variable",name:\{kind:"Name",value:"([A-Za-z0-9_]+)"\}\},type:\{',b):
        vn=m.group(1)
        # look at the type object chunk
        k=m.end(); d=1; q=k
        while q<len(b) and d>0:
            if b[q]=='{':d+=1
            elif b[q]=='}':d-=1
            q+=1
        tchunk=b[k:q]
        nn='NonNullType' in tchunk
        ty=re.findall(r'value:"([A-Za-z0-9_]+)"',tchunk)
        ty=[t for t in ty if t!='NonNullType' and t!='ListType' and t!='NamedType']
        vars.append((vn, ty[-1] if ty else '?', '!' if nn else ''))
    fields=[]
    sel=b[b.find('selectionSet:'):] if 'selectionSet:' in b else ''
    for fm in re.finditer(r'\{kind:"Field",name:\{kind:"Name",value:"([A-Za-z0-9_]+)"\}',sel):
        fields.append(fm.group(1))
    if name in seen: continue
    seen[name]=(op,vars,fields)
muts=sorted([k for k,v in seen.items() if v[0]=='mutation'])
qs=sorted([k for k,v in seen.items() if v[0]=='query'])
print("MUTATIONS",len(muts)); print(muts)
print(); print("QUERIES",len(qs)); print(qs)
json.dump(seen,open('ops.json','w'),indent=0)
