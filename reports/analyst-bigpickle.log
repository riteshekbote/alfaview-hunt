def refs(o,acc):
    if isinstance(o,dict):
        for k,v in o.items():
            if k=='\$ref' and isinstance(v,str) and v.startswith('#/components/schemas/'):
                acc.add(v.rsplit('/',1)[-1])
            else: refs(v,acc)
    elif isinstance(o,list):
        for i in o: refs(i,acc)
seed=set(); refs({'paths':d['paths']},seed)
reach=set()
def walk(name,seen):
    if name in seen: return
    seen.add(name); reach.add(name)
    a=set(); refs(S.get(name,{}),a); [walk(x,seen) for x in a]
