B=/tmp/opencode/probe
probe() {
  local name="$1" url="$2"
  local code size md5
  code=$(curl -sS -o "$B/$name.bin" -w "%{http_code}" "$url" 2>/dev/null)
  size=$(stat -c%s "$B/$name.bin" 2>/dev/null)
  md5=$(md5sum "$B/$name.bin" 2>/dev/null | cut -c1-8)
  printf "%-28s %s %sB md5=%s\n" "$name" "$code" "$size" "$md5"
  sleep 1.2
}
