import re
s=open('app_new.js',encoding='utf-8',errors='ignore').read()
def op_ctx(name, before=200, after=3000):
    for m in re.finditer(r'operation:"(?:mutation|query)"',s):
        seg=s[m.end():m.end()+300]
        nm=re.search(r'kind:"Name",value:"([A-Za-z0-9_]+)"',seg)
        if nm and nm.group(1)==name:
            return s[max(0,m.start()-before): m.end()+after]
    return None
for op in ['MagicTokenAuthenticate','CreateMagicToken','TokenAuthenticate','AdminSwitchCompany','FetchGuestInfo','ResetPassword','SetNewPassword','CreateApiKey','DisableMFA']:
    c=op_ctx(op)
    if not c: print(op,'NOT FOUND'); continue
    args=re.findall(r'kind:"Argument",name:\{kind:"Name",value:"([A-Za-z0-9_]+)"\}',c)
    # first-level selections (approx: all Field names after first selectionSet)
    idx=c.find('selectionSet')
    tail=c[idx:] if idx>0 else c
    fields=re.findall(r'kind:"Field",name:\{kind:"Name",value:"([A-Za-z0-9_]+)"',tail)
    print(f"{op}: args={args[:12]} replyfields={fields[:20]}")
EOF
