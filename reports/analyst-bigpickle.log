# who references Permissions / ParticipantPermissions?
tgt={'Permissions','ParticipantPermissions','PermissionsEdit'}
def collect(node,store,where):
    if isinstance(node,dict):
        for k,v in node.items():
            if k=='$ref' and isinstance(v,str):
                nm=v.rsplit('/',1)[-1]
                if nm in tgt: store.setdefault(nm,set()).add(where)
            else: collect(v,store,where)
    elif isinstance(node,list):
        for i in node: collect(i,store,where)
hits={}
for p,v in d['paths'].items(): collect(v,hits,p)
for nm,sch in S.items(): collect(sch,hits,'schema:'+nm)
for k in sorted(tgt): print(k,'<-',sorted(hits.get(k,[])))
EOF
