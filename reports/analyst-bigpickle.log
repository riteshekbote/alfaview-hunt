    for meth in ['get','post','patch','put','delete']:
        if re.search(r'^    '+meth+r':',txt,re.M):
            sub=re.search(r'^    '+meth+r':\n(.*?)(?=^    \w+:|^  /|\Z)',txt,re.M|re.S)
