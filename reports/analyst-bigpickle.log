  account_creation: restricted  # only on test/sandbox assets, never live customer data
  no_data_modification: true    # no writes/deletes on live customer data
  no_pre_disclosure: true       # never disclose before program response
  poc_required: true            # scanner output alone is REJECTED
  redact_secrets_in_commits: true

