import yaml,re,json,collections
d=yaml.safe_load(open('alfaview-openapi.yaml'))
schemas=d.get('components',{}).get('schemas',{})
raw=open('alfaview-openapi.yaml').read()

# 1. method distribution
mc=collections.Counter()
for p,v in d['paths'].items():
    for m in v:
        if m in ('get','post','put','patch','delete','head','options'): mc[m]+=1
print("METHODS:",dict(mc), "total", sum(mc.values()))

# 2. referenced schema names = any $ref '#/components/schemas/NAME'
refs=collections.Counter(re.findall(r"#/components/schemas/([A-Za-z0-9_]+)", raw))
# exclude the definitions themselves (key: NAME:) from being counted
orphans=[s for s in schemas if refs.get(s,0)==0]
print("SCHEMAS total",len(schemas),"ORPHANS",len(orphans))
print(json.dumps(sorted(orphans),indent=0))

# 3. other component kinds
for kind in ('parameters','responses','requestBodies','headers','securitySchemes','examples','links','callbacks'):
    cs=d.get('components',{}).get(kind,{})
    if not cs: 
        print(kind,"-> none/absent"); continue
    orp=[k for k in cs if ("#/components/%s/%s"%(kind,k)) not in raw.replace("#/components/%s/"%kind,"#/components/%s/"%kind)]
    # proper: count occurrences of the full pointer minus the 1 declaration
    orp=[]
    for k in cs:
        ptr="#/components/%s/%s"%(kind,k)
        n=raw.count(ptr)
        if n<=1: orp.append(k)
    print(kind,"total",len(cs),"ORPHAN(<=1 ref)",orp)

print("TOP-LEVEL security:", d.get('security','ABSENT'))
print("securitySchemes:", d.get('components',{}).get('securitySchemes','ABSENT'))
