import json,re
d=json.load(open('oa.json'))
S=d['components']['schemas']
def walk(name,sch,out,depth=0):
    if depth>6: return
    props=sch.get('properties',{}) if isinstance(sch,dict) else {}
    req=set(sch.get('required',[]) or []) if isinstance(sch,dict) else set()
    for k,v in props.items():
        f=v.get('format'); t=v.get('type'); pat=v.get('pattern'); ex=v.get('example'); mn=v.get('minLength'); mx=v.get('maxLength')
        if f or pat or mn or mx:
            out.append((name,k,t,f,pat,mn,mx,(k in req)))
    for k,v in props.items():
        if 'items' in v and v['items'].get('type')!='string':
            ref=v['items'].get('$ref')
            if ref: walk(name,S[ref.split('/')[-1]],out,depth+1)
        elif v.get('type')=='array':
            ref=v.get('items',{}).get('$ref')
            if ref: walk(name,S[ref.split('/')[-1]],out,depth+1)
    for key in ('oneOf','allOf','anyOf'):
        for sub in sch.get(key,[]) or []:
            if '$ref' in sub: walk(name,S[sub['$ref'].split('/')[-1]],out,depth+1)
out=[]
for n,s in S.items(): walk(n,s,out)
seen=set(); rows=[]
for r in out:
    k=(r[0],r[1])
    if k in seen: continue
    seen.add(k); rows.append(r)
print("=== format/pattern/length constrained fields ===")
for n,k,t,f,pat,mn,mx,req in sorted(rows):
    print(f"{n:34s} {k:26s} {str(t):8s} fmt={str(f):12s} min={str(mn):5s} max={str(mx):5s} req={req} pat={str(pat)[:46]}")
print()
print("=== any pattern: at all ===")
for n,s in S.items():
    for k,v in (s.get('properties') or {}).items():
        if v.get('pattern'): print(' ',n,k,v['pattern'][:80], 'maxLen',v.get('maxLength'),'minLen',v.get('minLength'))
