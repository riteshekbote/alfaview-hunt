import struct,subprocess,time
def call(svc,method,body=b''):
    frame=struct.pack('>BI',0,len(body))+body   # correct 5-byte gRPC frame
    p=subprocess.run(["curl","-s","-m","15","-X","POST","-H","content-type: application/grpc",
        "-H","te: trailers","--data-binary","@-","-D","-",
        f"https://apis.alfaview.com/{svc}/{method}"],input=frame,capture_output=True)
    out=p.stdout;i=out.find(b"\r\n\r\n");head=out[:i].decode(errors='ignore');b=out[i+4:]
    st={l.split(":")[0].lower():l.split(":",1)[1].strip() for l in head.split("\r\n") if ":" in l}
    pl=b""
    if b and len(b)>=5:
        ln=struct.unpack('>I',b[1:5])[0];pl=b[5:5+ln]
    return st,pl
