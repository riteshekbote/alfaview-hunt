import json,re
raw=open('av-openapi-live.json').read()
d=json.loads(raw); sch=d['components']['schemas']
# locate referrers by index proximity: use raw text, find each '#/components/schemas/NAME' index and nearest preceding top-level schema key
def refidx(name):
    return [m.start() for m in re.finditer(re.escape("#/components/schemas/"+name)+r'"',raw)]
import collections
for target in ['Actor','Event','Target','PaginatedBodyListEvent','RoomQuotas','RoomQuotasEdit','GroupLinkCreate','GuestLinkCreate','Stats','Translation','UserInformation','Participant','Attendance','Permissions','TokenUserPermissions','InviteUserPermissions','ErrorModel','ErrorDetail','SubroomCreateListItem','SubroomEditListItem']:
    idxs=refidx(target)
    owners=[]
    for i in idxs:
        pre=raw[:i]
        ks=list(re.finditer(r'^    ([A-Za-z0-9_]+):$',pre,re.M))
        if ks: owners.append(ks[-1].group(1))
    c=collections.Counter(owners)
    print("%-26s refs=%-3d owners=%s"%(target,len(idxs),dict(c)))
