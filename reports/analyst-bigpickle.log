import urllib.request,urllib.error,hashlib,time
UA={'User-Agent':'Mozilla/5.0','Accept':'application/json'}
def p(url,method='GET'):
    r=urllib.request.Request(url,headers=UA,method=method)
    try:
        resp=urllib.request.urlopen(r,timeout=25); st=resp.status; b=resp.read()
    except urllib.error.HTTPError as e:
        st=e.code; b=e.read()
    except Exception as e:
        return url,method,'ERR',str(e)[:60],0,''
    return url,method,st,len(b),hashlib.md5(b).hexdigest(),b[:260].decode('utf8','replace').replace('\n',' ')
