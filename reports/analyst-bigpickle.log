import re,json
s=open('app.js',encoding='utf-8',errors='replace').read()
# find OperationDefinition blocks by brace matching from each anchor
anchors=[m.start() for m in re.finditer(r'\{kind:"OperationDefinition",operation:"(mutation|query)"',s)]
print("anchors",len(anchors))
def block_at(i):
    d=0;j=i
    while j<len(s):
        if s[j]=='{':d+=1
        elif s[j]=='}':
            d-=1
            if d==0: return s[i:j+1]
        j+=1
    return s[i:i+200000]
ops=[]
for i in anchors:
    b=block_at(i)
    op=re.search(r'operation:"(mutation|query)"',b).group(1)
    nm=re.search(r'operation:"(?:mutation|query)",name:\{kind:"Name",value:"([A-Za-z0-9_]+)"',b)
    name=nm.group(1) if nm else None
    if not name: continue
    # variable definitions: variable name + type
    vardefs=re.findall(r'variable:\{kind:"Variable",name:\{kind:"Name",value:"([A-Za-z0-9_]+)"\}\},type:\{kind:"(NonNullType|ListType|NamedType)",(?:type:\{kind:"(?:NonNullType|ListType|NamedType)",(?:name:\{kind:"Name",value:)?)?"?([A-Za-z0-9_]+)"?)?',b)
    # selection field names
    fields=re.findall(r'selections:\[\{kind:"Field",name:\{kind:"Name",value:"([A-Za-z0-9_]+)"\}',b)
    ops.append((op,name,vardefs,fields,len(b)))
seen={}
for op,name,v,f,L in ops:
    seen.setdefault((op,name),[op,name,v,f,L])
print("unique ops",len(seen))
muts=sorted([k[1] for k in seen if k[0]=='mutation'])
qs=sorted([k[1] for k in seen if k[0]=='query'])
print("mutations",len(muts),muts)
print()
print("queries",len(qs))
open('ops.json','w').write(json.dumps([{"op":a,"name":b,"vars":c,"fields":d} for a,b,c,d,_ in seen.values()],indent=0))
