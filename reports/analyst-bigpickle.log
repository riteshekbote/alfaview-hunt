[0m$ [0mcd /tmp/opencode && python3 - <<'EOF'
import re,json
s=open('app.js',encoding='utf-8',errors='replace').read()
# root field = first selection after each selectionSet of an OperationDefinition
out={}
for m in re.finditer(r'operation:"(query|mutation)",name:\{kind:"Name",value:"([^"]+)"\}',s):
    kind,opname=m.group(1),m.group(2)
    seg=s[m.end():m.end()+1500]
    f=re.search(r'selectionSet:\{kind:"SelectionSet",selections:\[\{kind:"Field",name:\{kind:"Name",value:"([^"]+)"\}',seg)
    if not f: continue
    args=re.findall(r'arguments:\[(.*?)\],directives',seg[:f.start()+600],re.S)
    names=re.findall(r'kind:"Name",value:"(\w+)"',args[0]) if args else []
    out.setdefault(kind,{})[f.group(1)]=(opname,names)
for kind in ('query','mutation'):
    d=out.get(kind,{})
    print(f"=== {kind.upper()} ROOT FIELDS: {len(d)}")
    for k,(op,args) in sorted(d.items()):
        print(f"  {k:34s} args={args}")
    json.dump(d,open(f'{kind}fields.json','w'),indent=1)
