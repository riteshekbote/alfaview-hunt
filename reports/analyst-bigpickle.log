probe () {
  local url="$1"
  local out
  out=$(curl -s -m 12 -H 'Accept: application/json' -w '\n__H__%{http_code}|%{size_download}' "$url")
  local meta="${out##*__H__}"
  local body="${out%$'\n'__H__*}"
  local locs
  locs=$(printf '%s' "$body" | jq -c '[.errors[]?.location] // empty' 2>/dev/null)
  local md5
