refs={}
for k in S:
    # find refs outside the schema definition block: count occurrences of \"#/components/schemas/<k>\"
    n=txt.count('\"#/components/schemas/%s\"'%k)
    refs[k]=n
orph=[k for k,v in refs.items() if v==0]
