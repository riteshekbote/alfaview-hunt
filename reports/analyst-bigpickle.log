import json,yaml
old=yaml.safe_load(open('old.yaml')); new=json.load(open('live2.json'))
def ops(d):
    out={}
    for p,v in d['paths'].items():
        for m,o in v.items():
            if m in ('get','post','put','delete','patch'): out[(m,p)]=o
    return out
O,N=ops(old),ops(new)
def pset(o):
    res=[]
    for par in o.get('parameters',[]):
        res.append((par.get('name'),par.get('in'),par.get('required'),json.dumps(par.get('schema',{}))))
    return res
for k in sorted(set(O)&set(N)):
    a,b=pset(O[k]),pset(N[k])
    if a!=b:
        print(k)
        print('  only old',[x for x in a if x not in b])
        print('  only new',[x for x in b if x not in a])
# requestBody delta
for k in sorted(set(O)&set(N)):
    a=json.dumps(O[k].get('requestBody'));b=json.dumps(N[k].get('requestBody'))
    if a!=b: print('BODY DELTA',k,a[:300],'->',b[:300])
# 401 header content
r=new['paths']['/v2/users']['get']['responses']['401']
print(json.dumps(r['headers'],indent=1))
